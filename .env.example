# Copy to data/.env (or export in your shell). Everything is optional.

# Where acta.db, events.json, backups and reports live (default: ./data)
# ACTA_DATA_DIR=./data

# The Gadgetbridge export to ingest (default: $ACTA_DATA_DIR/Gadgetbridge.db)
# ACTA_GADGETBRIDGE_DB=~/sync/Gadgetbridge.db

# Home time zone; days fall back to it when the strap reports none (default: this machine's zone)
# ACTA_TZ=Europe/Lisbon

# Where the API listens (default: 127.0.0.1:8000)
# ACTA_HOST=127.0.0.1
# ACTA_PORT=8000

# Food lookup and Auspex narration (https://openrouter.ai)
# OPENROUTER_API_KEY=

# Price feed fallbacks for investments (Yahoo needs no key)
# TWELVEDATA_API_KEY=
# TAVILY_API_KEY=
